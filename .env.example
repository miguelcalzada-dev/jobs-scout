# Configuración del proyecto
# IMPORTANTE: Copia este archivo a .env y rellénalo con tus valores reales

# API Key de Resend para envío de emails (OBLIGATORIO)
# Regístrate en https://resend.com y genera una API key
RESEND_API_KEY=

# API Key de OpenAI (opcional, solo para parseo avanzado del CV)
# Sin esto, el sistema usará regex para parsear el CV (menos preciso)
OPENAI_API_KEY=

# Email de envío via Resend
# El from debe ser un dominio verificado en Resend o "onboarding@resend.dev" en modo test
EMAIL_USER=onboarding@resend.dev
EMAIL_FROM=Jobs Scout <onboarding@resend.dev>
EMAIL_TO=tuemail@gmail.com

# Hora diaria de envío (formato 24h, hora española)
DAILY_SEND_HOUR=20
DAILY_SEND_MINUTE=0

# Máximo de ofertas a enviar por día
MAX_JOBS_PER_DAY=10

# Puerto del servidor web (necesario para Railway)
PORT=8080

# Entorno: development | production
ENVIRONMENT=development

# Límite de días de antigüedad de ofertas
MAX_JOB_AGE_DAYS=3

# Headless mode para playwright (false para debug visual, true para producción)
HEADLESS=true

# Timezone
TZ=Europe/Madrid
