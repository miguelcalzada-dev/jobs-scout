# Configuración del proyecto
# IMPORTANTE: Copia este archivo a .env y rellénalo con tus valores reales

# API Key de OpenAI (opcional, solo para parseo avanzado del CV)
# Sin esto, el sistema usará regex para parsear el CV (menos preciso)
OPENAI_API_KEY=

# Email de envío (Gmail recomendado)
# Ve a https://myaccount.google.com/apppasswords para generar una contraseña de app
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tuemail@gmail.com
EMAIL_PASSWORD=tu-app-password
EMAIL_FROM=Jobs Scout <tuemail@gmail.com>
EMAIL_TO=tuemail@gmail.com

# Hora diaria de envío (formato 24h, hora española)
DAILY_SEND_HOUR=9
DAILY_SEND_MINUTE=0

# Máximo de ofertas a enviar por día
MAX_JOBS_PER_DAY=10

# Puerto del servidor web (necesario para Railway)
PORT=8080

# Entorno: development | production
ENVIRONMENT=development

# Límite de años de antigüedad de ofertas (0 = sin límite)
MAX_JOB_AGE_DAYS=3

# Headless mode para playwright (false para debug visual, true para producción)
HEADLESS=true

# Timezone
TZ=Europe/Madrid
